            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/will/projects/USER/mdcs/node_modules/.pnpm/office-addin-usage-data@1.6.14/node_modules/office-addin-usage-data/node_modules:/home/will/projects/USER/mdcs/node_modules/.pnpm/office-addin-usage-data@1.6.14/node_modules:/home/will/projects/USER/mdcs/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/will/projects/USER/mdcs/node_modules/.pnpm/office-addin-usage-data@1.6.14/node_modules/office-addin-usage-data/node_modules:/home/will/projects/USER/mdcs/node_modules/.pnpm/office-addin-usage-data@1.6.14/node_modules:/home/will/projects/USER/mdcs/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../office-addin-usage-data@1.6.14/node_modules/office-addin-usage-data/cli.js" "$@"
else
  exec node  "$basedir/../../../../../office-addin-usage-data@1.6.14/node_modules/office-addin-usage-data/cli.js" "$@"
fi
