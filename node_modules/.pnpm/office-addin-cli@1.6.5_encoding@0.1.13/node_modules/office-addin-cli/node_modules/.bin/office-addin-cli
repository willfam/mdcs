#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/will/projects/USER/lta-btds-gui/node_modules/.pnpm/office-addin-cli@1.6.5_encoding@0.1.13/node_modules/office-addin-cli/node_modules:/home/will/projects/USER/lta-btds-gui/node_modules/.pnpm/office-addin-cli@1.6.5_encoding@0.1.13/node_modules:/home/will/projects/USER/lta-btds-gui/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/will/projects/USER/lta-btds-gui/node_modules/.pnpm/office-addin-cli@1.6.5_encoding@0.1.13/node_modules/office-addin-cli/node_modules:/home/will/projects/USER/lta-btds-gui/node_modules/.pnpm/office-addin-cli@1.6.5_encoding@0.1.13/node_modules:/home/will/projects/USER/lta-btds-gui/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../cli.js" "$@"
else
  exec node  "$basedir/../../cli.js" "$@"
fi
